package templates

const githubProfilePicture = "https://avatars1.githubusercontent.com/u/10263186?s=460&u=92a0ab05fe989c7aa4b5a07e5b8d8c8737dba4a1&v=4"

templ Navbar() {
	<nav class="navbar navbar-expand-md navbar-dark navbar-custom" x-data="{ open: false }">
		<a href="/" class="navbar-home">
			<div class="row no-gutters align-items-center">
				<div class="col"><img src={ githubProfilePicture } height="40px" alt="GitHub profile picture"/></div>
				<div class="col"><span class="navbar-brand ml-2">/chord-prog-mult</span></div>
			</div>
		</a>
		<button type="button" class="navbar-toggler" aria-label="Toggle navigation" x-on:click="open = !open">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" x-bind:class="{ 'show': open }">
			<div class="nav-item"><a href="/" class="nav-link">Home</a></div>
			<div class="nav-item"><a href="/catalog" class="nav-link">Catalog</a></div>
			<div class="nav-item"><a href="/approach" class="nav-link">Approach</a></div>
			<div class="nav-item"><a href="https://github.com/Warpyn/chord-prog-mult" class="nav-link">GitHub</a></div>
		</div>
	</nav>
}
